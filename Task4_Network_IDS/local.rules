# Local Suricata rules for the CodeAlpha lab.
# These rules alert only; they do not block or reject traffic.

alert http any any -> any any (msg:"CODEALPHA LAB Possible request for exposed .env file"; flow:established,to_server; http.uri; content:"/.env"; startswith; nocase; classtype:attempted-recon; sid:1001001; rev:1;)
alert http any any -> any any (msg:"CODEALPHA LAB Possible web admin path probe"; flow:established,to_server; http.uri; content:"/wp-admin"; startswith; nocase; classtype:attempted-recon; sid:1001002; rev:1;)
alert dns any any -> any any (msg:"CODEALPHA LAB Query for reserved training domain"; dns.query; content:"training-phish.invalid"; nocase; sid:1001003; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"CODEALPHA LAB Possible TCP SYN scan"; flags:S; flow:stateless; threshold:type both, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:1001004; rev:1;)
